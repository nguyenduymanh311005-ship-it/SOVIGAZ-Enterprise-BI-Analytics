{
  "name": "Sovigaz Corporate Theme",
  "dataColors": [
    "#0487CA",
    "#3049AD",
    "#FFB92E",
    "#118DFF",
    "#206195",
    "#750985",
    "#C83D95",
    "#FF985E",
    "#1DD5EE",
    "#42F7C0"
  ],
  "background": "#FFFFFF",
  "foreground": "#070F25",
  "tableAccent": "#0487CA",
  "good": "#107C41",
  "neutral": "#FFB92E",
  "bad": "#D83B01",
  "maximum": "#0487CA",
  "center": "#FFB92E",
  "minimum": "#F2F2F2",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI",
      "color": "#0487CA"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#070F25"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#333333"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#666666"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "radius": 6
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F4"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
